From 16e676a6e57839e582004c06d36130f0c94b23bd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 22 Aug 2026 15:38:23 +0000
Subject: [PATCH 1/2] fix(fixes): stop injecting inherited text-indent into
 book CSS
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

_fix_css wrote `body, p, li, blockquote { text-indent: 2em }` whenever the
book had no text-indent of its own. text-indent is an *inherited* property,
so it reached every block container in the book — including fixed-width
inline-block badges and the divs used to draw diagrams — pushing their
contents out of their boxes. In a real book this made table-of-contents
numerals overlap the chapter titles and staggered the lines of a hexagram
figure.

Two changes:

  * text-indent is no longer applied automatically. TYPO-075 already
    reports its absence; whether to indent is a design decision, and books
    that separate paragraphs by margin must not be indented at all.

  * The remaining baseline properties are written to `body` only. They are
    all inherited, so a single body rule is enough, and the narrower
    selector can no longer out-specify the author's own layout rules.

Adds regression tests asserting the fixer never emits text-indent and that
its CSS block targets body alone.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TWVhEKkpMiaADSLp97Qco3
---
 epubqa/fixes.py      | 14 +++++++++++---
 tests/test_epubqa.py | 23 +++++++++++++++++++++++
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/epubqa/fixes.py b/epubqa/fixes.py
index 4bdee95..bc5ef5a 100644
--- a/epubqa/fixes.py
+++ b/epubqa/fixes.py
@@ -624,18 +624,26 @@ def _fix_css(epub: Epub, lang: str, result: FixResult) -> None:
         for prop, value in profile.required_css.items()
         if not re.search(rf"\b{re.escape(prop)}\s*:", css)
     }
-    if lang in ("zh-Hant", "zh-Hans", "ja") and not re.search(r"text-indent", css):
-        missing["text-indent"] = "2em"
     if not re.search(r"line-height", css):
         missing["line-height"] = "1.8" if lang != "en" else "1.5"
 
+    # text-indent is deliberately NOT auto-applied. It is an *inherited*
+    # property, so writing it here leaks into every block container in the
+    # book — including inline-blocks used as fixed-width badges and the divs
+    # that draw diagrams — pushing their contents out of their boxes. It also
+    # clashes with designs that separate paragraphs by margin instead of
+    # indentation. TYPO-075 reports it; a human decides.
+
     if not missing:
         return
 
     block = "\n".join(f"  {k}: {v};" for k, v in missing.items())
+    # Applied to body only: every property here is inherited, and any rule the
+    # book already has wins on specificity. A broader selector list would
+    # override the author's own layout.
     addition = (
         f"\n\n/* --- epubqa: {profile.name} 排版基準 --- */\n"
-        f"body, p, li, blockquote {{\n{block}\n}}\n"
+        f"body {{\n{block}\n}}\n"
     )
     epub.set_text(target.path, css + addition)
     result.add(
