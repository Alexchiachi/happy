# Google AI Studio 的 API 金鑰（必填）——只放在伺服器端，永遠不要進到前端
GEMINI_API_KEY=your-key-here

# 模型設定。預設值取自系統規格書；正式部署前請以你帳號實際可用的模型名稱為準，
# 可用 GET /api/health 確認目前掛載的是哪幾個。
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL_FALLBACK=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede

# TTS 回傳的原始 PCM 規格（用於組裝 WAV 檔頭）
TTS_SAMPLE_RATE=24000
TTS_CHANNELS=1
TTS_BITS_PER_SAMPLE=16

# 伺服器
PORT=8787
# 允許呼叫的前端來源，以逗號分隔；留空代表允許任何來源（僅適合本機開發）
ALLOWED_ORIGINS=https://alexchiachi.github.io
# 每個 IP 在時間窗內可生成的次數（生成要花錢，務必保留）
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# 進階：Gemini 端點（測試或自架代理時才需要覆寫）
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
